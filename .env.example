# Copy locally to .env only for an approved, configured environment.
# Resolve values from the approved server secret store; never commit keys.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_REPLY_TO=
KYREC_CORE_URL=
KYREC_CORE_SERVICE_ID=
KYREC_CORE_SERVICE_KEY=
KYREC_CORE_EXPECTED_COMMIT=
OPENAI_API_KEY=
OPENAI_COMPANION_MODEL=
# Proposed beta limit; approve model/project/cost before production use.
OPENAI_MAX_DAILY_REQUESTS=20
# Browser key is public by design. Restrict referrers + Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
GUARDIAN_SOURCE_COMMIT=
VITE_AUTH_ENABLED=true
GUARDIAN_RUNTIME_MODE=production
NITRO_HOST=0.0.0.0
NITRO_PORT=8080
